{
  "id": "aurelm-weather-net",
  "kind": "tool",
  "version": "0.1.0",
  "title": "Weather & Road Internet Service",
  "description": "Dedicated mgu-uplink internet fetch service for Weather & Road Info. HTTPS requests run under a separate internet UID, not root.",
  "requires": { "mgu-deploy": "0.7.0" },
  "uninstallable": true,
  "internet": true,
  "uids": "state/internet-uids",
  "mguHmi": ["ID7"],
  "files": [
    { "path": "netd.js", "from": "netd.js", "mode": "0644" }
  ],
  "units": [
    { "name": "aurelm-weather-net.service", "from": "systemd/aurelm-weather-net.service" }
  ],
  "enable": [
    { "unit": "aurelm-weather-net.service", "target": "multi-user.target" }
  ],
  "restart": ["aurelm-weather-net.service"]
}
