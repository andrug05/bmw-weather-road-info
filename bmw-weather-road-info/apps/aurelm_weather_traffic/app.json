{
  "id": "aurelm_weather_traffic",
  "title": "Weather & Road Info",
  "description": "7Timer! global weather forecast and OpenStreetMap road information via mgu-uplink.",
  "version": "0.2.7",
  "vendor": "andrug05",
  "loggingId": "AWR1",
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "Weather & Road Info",
      "buttons": [
        ["BTN_REFRESH", "Refresh"],
        ["BTN_WEATHER", "Weather"],
        ["BTN_ROADS", "Roads"],
        ["BTN_LOCATION", "Next city / GPS"]
      ]
    }
  ],
  "settings": [
    {
      "key": "location_mode",
      "label": "Location source",
      "type": "choice",
      "default": "gps",
      "options": [["gps", "Vehicle GPS"], ["manual", "Manual city"]]
    },
    {
      "key": "city",
      "label": "Manual city",
      "type": "choice",
      "default": "yoshkar_ola",
      "options": [
        ["berlin", "Berlin"],
        ["yoshkar_ola", "Yoshkar-Ola"],
        ["moscow", "Moscow"],
        ["sochi", "Sochi"]
      ]
    }
  ],
  "internet": true
}
